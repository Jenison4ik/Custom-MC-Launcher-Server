PORT=8080
JWT_SECRET=change-me-to-a-long-random-string
JWT_EXPIRES=12h
ADMIN_USERNAME=admin
ADMIN_PASSWORD=change-me
CORS_ORIGIN=http://localhost:5173
# Каждый символ $ в ключе CurseForge пишите дважды, иначе Docker Compose его обрежет.
CURSEFORGE_API_KEY=
# Каталог клона репозитория и кэша сборки лаунчера. По умолчанию ./builds
BUILD_DIR=
# Исходники лаунчера. Ветка или тег — LAUNCHER_REPO_REF.
LAUNCHER_REPO_URL=https://github.com/Jenison4ik/Custom-MC-Launcher.git
LAUNCHER_REPO_REF=main
# Адрес API внутри собранного лаунчера. Если пусто, берётся https://$DOMAIN/minecraft/api
PUBLIC_API_URL=
DOMAIN=
